ac_add_options --with-app-name=${binName}
export MOZ_USER_DIR="${name}"
export MOZ_APP_BASENAME=${binName}
export MOZ_DISTRIBUTION_ID=${appId}

# No stub installer: it can only download+verify Mozilla-signed payloads
# from Mozilla URLs, so an Aurelia stub could never install anything.
export MOZ_INCLUDE_SOURCE_INFO=1
export MOZ_SOURCE_REPO=https://github.com/local/aurelia
export MOZ_SOURCE_CHANGESET=${changeset}

# Bootstrap
ac_add_options --enable-bootstrap
ac_add_options --enable-application=browser

# Optimised release build
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests

# Privacy: no crash reporter, no default-browser agent, no updater (v0.1 local build)
ac_add_options --disable-crashreporter
ac_add_options --disable-default-browser-agent
ac_add_options --disable-backgroundtasks
ac_add_options --disable-updater

# No telemetry / data reporting (belt; moz.configure patch is the braces)
mk_add_options MOZ_TELEMETRY_REPORTING=
mk_add_options MOZ_DATA_REPORTING=
mk_add_options MOZ_SERVICES_HEALTHREPORT=
ac_add_options MOZ_TELEMETRY_REPORTING=
ac_add_options MOZ_DATA_REPORTING=
export MOZ_TELEMETRY_REPORTING=
export MOZ_DATA_REPORTING=
export MOZ_CRASHREPORTER=
export MOZ_REQUIRE_SIGNING=
